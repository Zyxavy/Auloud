<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 7 throwaway spike: no permissions beyond shared-storage read/write
     (sideloaded model packs + results export, same sneakernet as v1).
     No INTERNET, like the app. Deleted after the gate. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:label="Auloud Spike"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".SpikeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
